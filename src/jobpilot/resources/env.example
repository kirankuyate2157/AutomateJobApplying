# Copy to .env and fill in. This file is loaded automatically by `jobpilot`.
# WHY: secrets belong in the environment, not in tracked python files.

# LinkedIn (optional: if empty you log in manually once; the browser profile
# in data/chrome-profile keeps you logged in afterwards)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# LLM provider keys (only the one you configure in settings.yaml is needed)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# SMTP for outreach mails (Gmail: create an "App Password", never your real one)
SMTP_USER=
SMTP_APP_PASSWORD=
